digraph G {
graph [charset="UTF-8", rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="0.65", splines=polyline];
node [shape=plain, fontname="DejaVu Sans", fontsize=15];
edge [fontname="DejaVu Sans", fontsize=12, color="#526579", arrowsize=0.7];
employee [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#526579"><TR><TD BGCOLOR="#E7EFF7"><B>Сотрудник<BR/>employee</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD></TR><TR><TD ALIGN="LEFT">manager_id [FK]</TD></TR></TABLE>>];
pc [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#526579"><TR><TD BGCOLOR="#E7EFF7"><B>Игровой ПК<BR/>pc</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD></TR></TABLE>>];
session [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#526579"><TR><TD BGCOLOR="#E7EFF7"><B>Игровая сессия<BR/>session</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD></TR><TR><TD ALIGN="LEFT">guest_id [FK]</TD></TR><TR><TD ALIGN="LEFT">pc_id [FK]</TD></TR><TR><TD ALIGN="LEFT">tariff_id [FK]</TD></TR><TR><TD ALIGN="LEFT">booking_id [FK]</TD></TR></TABLE>>];
booking [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#526579"><TR><TD BGCOLOR="#E7EFF7"><B>Бронирование<BR/>booking</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD></TR><TR><TD ALIGN="LEFT">guest_id [FK]</TD></TR><TR><TD ALIGN="LEFT">pc_id [FK]</TD></TR><TR><TD ALIGN="LEFT">created_by [FK]</TD></TR></TABLE>>];
service_ticket [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#526579"><TR><TD BGCOLOR="#E7EFF7"><B>Заявка обслуживания<BR/>service_ticket</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD></TR><TR><TD ALIGN="LEFT">pc_id [FK]</TD></TR><TR><TD ALIGN="LEFT">session_id [FK]</TD></TR><TR><TD ALIGN="LEFT">created_by [FK]</TD></TR><TR><TD ALIGN="LEFT">assigned_to [FK]</TD></TR></TABLE>>];
software [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#526579"><TR><TD BGCOLOR="#E7EFF7"><B>Программное обеспечение<BR/>software</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD></TR></TABLE>>];
pc_software [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#526579"><TR><TD BGCOLOR="#E7EFF7"><B>ПО на ПК<BR/>pc_software</B></TD></TR><TR><TD ALIGN="LEFT">pc_id [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">software_id [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">updated_by [FK]</TD></TR></TABLE>>];
employee -> employee [label="0..1 : 0..N\nmanager_id", style=solid];
pc -> booking [label="1 : 0..N\npc_id", style=solid];
employee -> booking [label="1 : 0..N\ncreated_by", style=solid];
pc -> session [label="1 : 0..N\npc_id", style=solid];
booking -> session [label="0..1 : 0..1\nbooking_id", style=solid];
pc -> service_ticket [label="1 : 0..N\npc_id", style=solid];
session -> service_ticket [label="0..1 : 0..N\nsession_id", style=solid];
employee -> service_ticket [label="1 : 0..N\ncreated_by", style=solid];
employee -> service_ticket [label="0..1 : 0..N\nassigned_to", style=solid];
pc -> pc_software [label="1 : 0..N\npc_id", style=solid];
software -> pc_software [label="1 : 0..N\nsoftware_id", style=solid];
employee -> pc_software [label="1 : 0..N\nupdated_by", style=solid];
}