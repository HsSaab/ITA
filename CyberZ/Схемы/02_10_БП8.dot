digraph G {
graph [charset="UTF-8", rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="0.65", splines=polyline];
node [shape=plain, fontname="DejaVu Sans", fontsize=15];
edge [fontname="DejaVu Sans", fontsize=12, color="#526579", arrowsize=0.7];
n0 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#526579"><TR><TD BGCOLOR="#E7EFF7"><B>Гость</B></TD></TR><TR><TD ALIGN="LEFT">Купить турнирный пакет на 5 часов</TD></TR></TABLE>>];
n1 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#526579"><TR><TD BGCOLOR="#E7EFF7"><B>Гость</B></TD></TR><TR><TD ALIGN="LEFT">Самостоятельно подключиться с ПК клуба</TD></TR></TABLE>>];
n2 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#526579"><TR><TD BGCOLOR="#E7EFF7"><B>Техническая поддержка</B></TD></TR><TR><TD ALIGN="LEFT">Провести турнир и зафиксировать результаты</TD></TR></TABLE>>];
n0 -> n1 [label="", style=solid];
