digraph G {
graph [charset="UTF-8", rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="0.65", splines=polyline];
node [shape=plain, fontname="DejaVu Sans", fontsize=15];
edge [fontname="DejaVu Sans", fontsize=12, color="#526579", arrowsize=0.7];
director [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#526579"><TR><TD BGCOLOR="#E7EFF7"><B>Директор</B></TD></TR><TR><TD ALIGN="LEFT">Стратегия и утверждение расходов</TD></TR></TABLE>>];
manager [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#526579"><TR><TD BGCOLOR="#E7EFF7"><B>Управляющий</B></TD></TR><TR><TD ALIGN="LEFT">Организация работы клуба</TD></TR><TR><TD ALIGN="LEFT">Тарифы и качество обслуживания</TD></TR></TABLE>>];
admin [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#526579"><TR><TD BGCOLOR="#E7EFF7"><B>Администратор</B></TD></TR><TR><TD ALIGN="LEFT">Приём гостей и оплата</TD></TR><TR><TD ALIGN="LEFT">Бронирование, подготовка и обновление ПК</TD></TR></TABLE>>];
tech [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#526579"><TR><TD BGCOLOR="#E7EFF7"><B>Техническая поддержка</B></TD></TR><TR><TD ALIGN="LEFT">Диагностика программных сбоев</TD></TR><TR><TD ALIGN="LEFT">Проведение турниров</TD></TR></TABLE>>];
guest [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#526579"><TR><TD BGCOLOR="#E7EFF7"><B>Гость<BR/>внешний участник</B></TD></TR><TR><TD ALIGN="LEFT">Выбор тарифа и действий в сессии</TD></TR></TABLE>>];
lg [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#526579"><TR><TD BGCOLOR="#E7EFF7"><B>LanGame<BR/>информационная система</B></TD></TR><TR><TD ALIGN="LEFT">Учёт и автоматизированные проверки</TD></TR></TABLE>>];
director -> manager [label="подчинение", style=solid];
manager -> admin [label="подчинение", style=solid];
manager -> tech [label="координация", style=dashed];
admin -> tech [label="обращения и диагностика", style=dashed];
guest -> admin [label="обслуживание", style=dashed];
admin -> lg [label="работа в системе", style=dashed];
{rank=same; admin; tech;}
{rank=same; guest; lg;}
}